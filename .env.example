# Copy to .env.local for local development (never commit .env.local).

# Neon connection strings (Neon console → Connect, or added automatically by
# the Neon integration on Vercel). The app uses the pooled one; migrations use
# the direct, unpooled one.
DATABASE_URL=postgres://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Passcode for /admin. Without it, /admin is open in development and hidden in production.
ADMIN_PASSWORD=change-me
# Optional: sign admin sessions with a separate secret (rotate it to sign everyone out).
ADMIN_SESSION_SECRET=

# Secret Vercel Cron sends to /api/cron/record-day (any long random string).
CRON_SECRET=
